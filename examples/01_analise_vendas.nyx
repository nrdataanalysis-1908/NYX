# Proposta de programa NYX — ainda não executável
# Objetivo: consolidar indicadores comerciais por região.

module analise_vendas

data vendas = read_csv("data/vendas.csv")

data vendas_validas = vendas
    .filter(valor > 0)
    .select("regiao", "valor")

data resumo_regional = vendas_validas
    .group_by("regiao")
    .aggregate(
        faturamento = sum(valor),
        ticket_medio = mean(valor),
        transacoes = count()
    )

resumo_regional.show()
