# Proposta de programa NYX — ainda não executável
# Objetivo: avaliar medições de sensores e resumir a qualidade dos dados.

module analise_sensores

data leituras = read_csv("data/leituras_sensores.csv")

data leituras_validas = leituras
    .filter(valor != null)
    .filter(estado == "valido")
    .select("sensor", "valor")

data indicadores = leituras_validas
    .group_by("sensor")
    .aggregate(
        amostras = count(),
        media = mean(valor),
        desvio_padrao = standard_deviation(valor),
        minimo = min(valor),
        maximo = max(valor)
    )

indicadores.show()
