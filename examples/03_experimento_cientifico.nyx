# Proposta de programa NYX — ainda não executável
# Objetivo: comparar grupos experimentais por meio de estatística descritiva.

module experimento_cientifico

data observacoes = read_csv("data/experimento.csv")

data amostras_aceitas = observacoes
    .filter(resposta != null)
    .filter(qualidade == "aprovada")
    .select("grupo", "resposta")

data comparacao = amostras_aceitas
    .group_by("grupo")
    .aggregate(
        tamanho_amostral = count(),
        resposta_media = mean(resposta),
        resposta_mediana = median(resposta),
        dispersao = standard_deviation(resposta)
    )

comparacao.show()
