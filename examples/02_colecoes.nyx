# NYX 0.6 — listas, indexação e mutabilidade.

let temperatures = [21.5, 22.0, 23.4]
let matrix = [[1, 2], [3, 4]]
let metadata = ["sensor-A", true, null]

print(temperatures[0])
temperatures[1] = 22.8
append(temperatures, 24.1)

print(len(temperatures))
print(temperatures[1])
print(matrix[1][0])
print(metadata[0])

# Listas são compartilhadas por referência.
let alias = temperatures
append(alias, 25.0)
print(len(temperatures))
